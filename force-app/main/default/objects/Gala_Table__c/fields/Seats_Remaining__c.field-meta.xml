<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Seats_Remaining__c</fullName>
    <description>Open seats at this table = Capacity - Seats Filled. Shows partially-filled tables at a glance. Gala Event Gifts / Jason Ott.</description>
    <externalId>false</externalId>
    <formula>BLANKVALUE(Capacity__c, 0) - BLANKVALUE(Seats_Filled__c, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Seats Remaining</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
