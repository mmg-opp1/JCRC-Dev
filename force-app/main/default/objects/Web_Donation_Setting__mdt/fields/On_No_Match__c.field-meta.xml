<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>On_No_Match__c</fullName>
    <description>What to do when nothing matches. Create keeps the gift flowing and may produce duplicates; Fail holds the submission so a person decides, at the cost of nothing being recorded until they do. Website Donations / Jason Ott.</description>
    <fieldManageability>DeveloperControlled</fieldManageability>
    <label>When No Contact Matches</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Create</fullName>
                <default>true</default>
                <label>Create a new contact</label>
            </value>
            <value>
                <fullName>Fail</fullName>
                <default>false</default>
                <label>Fail the submission for review</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
