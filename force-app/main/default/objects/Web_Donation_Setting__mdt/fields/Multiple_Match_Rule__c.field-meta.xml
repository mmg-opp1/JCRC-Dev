<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Multiple_Match_Rule__c</fullName>
    <description>Which record wins when more than one contact matches. Oldest makes repeat donors converge on their established record; Fail refuses to guess. Website Donations / Jason Ott.</description>
    <fieldManageability>DeveloperControlled</fieldManageability>
    <label>When Several Contacts Match</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Oldest</fullName>
                <default>true</default>
                <label>Use the oldest record</label>
            </value>
            <value>
                <fullName>Newest</fullName>
                <default>false</default>
                <label>Use the newest record</label>
            </value>
            <value>
                <fullName>Fail</fullName>
                <default>false</default>
                <label>Fail the submission for review</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
