<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Contact_Match_Rule__c</fullName>
    <description>How an incoming donor is matched to an existing contact. Email only is the safest: attaching a gift to the WRONG donor is far more damaging than creating a duplicate staff can merge. Looser rules match more but risk mis-attribution. Website Donations / Jason Ott.</description>
    <fieldManageability>DeveloperControlled</fieldManageability>
    <label>Contact Match Rule</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Email</fullName>
                <default>true</default>
                <label>Email only (exact)</label>
            </value>
            <value>
                <fullName>EmailOrFirstLast</fullName>
                <default>false</default>
                <label>Email, else First + Last name</label>
            </value>
            <value>
                <fullName>FirstLastEmail</fullName>
                <default>false</default>
                <label>First + Last + Email all match</label>
            </value>
            <value>
                <fullName>None</fullName>
                <default>false</default>
                <label>Never match - always create</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
