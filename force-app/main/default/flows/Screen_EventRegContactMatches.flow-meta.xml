   MID({!cdtPotentialMatches.outputActionedRowString},
       FIND(&apos;&quot;name&quot;:&quot;&apos;, {!cdtPotentialMatches.outputActionedRowString}) + 8,
       FIND(&apos;&quot;&apos;, {!cdtPotentialMatches.outputActionedRowString}, FIND(&apos;&quot;name&quot;:&quot;&apos;, {!cdtPotentialMatches.outputActionedRowString}) + 8)
