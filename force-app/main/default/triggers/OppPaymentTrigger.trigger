/**
 * @description Before a Payment is saved for the first time:
 *                - fills its Payment Method in from the Opportunity it belongs to, so nobody has to open
 *                  a payment NPSP created for them just to say how the gift was paid;
 *                - remembers the amount it was created with (Original_Payment_Amount__c), so a later
 *                  underpayment shows (Underpayment__c).
 *
 *              Note there is a second trigger on this object, dlrs_npe01_OppPaymentTrigger, which is
 *              generated by Declarative Lookup Rollup Summaries and must not be edited by hand. The
 *              two are independent: that one recalculates rollups after save, this one stamps a field
 *              before save, so the order they run in does not matter.
 *
 *              Author: Jason Ott.
 *
 * Change Log:
 * -----------
 * 2026-10-12 - Jason Ott - Also stamps Original Payment Amount (PaymentAmountService).
 */
trigger OppPaymentTrigger on npe01__OppPayment__c (before insert) {
    PaymentMethodService.applyFromOpportunity(Trigger.new);
    PaymentAmountService.stampOriginalAmount(Trigger.new);
}